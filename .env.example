# Supabase project connection (anon key only — safe for the browser, data is protected by RLS).
# Copy this file to .env.local and fill in your project's values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values for the Mine -> Kenshu automatic sign-in handoff.
SUPABASE_SERVICE_ROLE_KEY=
MINE_HANDOFF_SECRET=replace-with-the-same-32-character-secret-used-by-mine

# Server-to-server secret protecting POST /api/mine/match-count. Mine sends the same value
# as KENSHU_LINK_MATCH_COUNT_SECRET. Use a different value from MINE_HANDOFF_SECRET.
KENSHU_LINK_MATCH_COUNT_SECRET=replace-with-a-different-32-character-secret
